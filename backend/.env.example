# Copy to backend/.env (gitignored) and fill in. Every variable is optional.

# GitHub token for live enrichment (founder profiles, org lookup at registration).
# Without it GitHub allows 60 requests/hour per IP; with it, 5,000/hour.
# Fine-grained token: Repository access = "Public repositories (read-only)",
# no other permissions. Classic token: tick no scopes at all.
VIQ_GITHUB_TOKEN=

# data.gov.in API key (free: sign up at https://www.data.gov.in, then "My Account → API key").
# Needed only for the bulk MCA registry import (scripts/import_mca_registry.py).
# Without it, single-CIN lookups still work through the public sample key.
VIQ_DATA_GOV_IN_KEY=

# RapidAPI key for founder LinkedIn profiles (linkedin-scraper27).
# Unset = founder LinkedIn data falls back to the labelled mock.
VIQ_RAPIDAPI_KEY=
# Override only if you switch provider; defaults suit linkedin-scraper27.
# VIQ_LINKEDIN_API_HOST=linkedin-scraper27.p.rapidapi.com
# VIQ_LINKEDIN_API_PATH=/profile_details
# VIQ_LINKEDIN_API_PARAM=username

# Signing key for login tokens. Leave unset locally (one is generated into
# backend/artifacts/ on first use); set a long random value in deployment, or
# everyone is signed out on each restart.
VIQ_JWT_SECRET=

# Google sign-in (optional). Create an OAuth client (type: Web application) at
# console.cloud.google.com, and register this exact redirect URI:
#   http://localhost:8000/api/auth/google/callback
VIQ_GOOGLE_CLIENT_ID=
VIQ_GOOGLE_CLIENT_SECRET=
# Override when deployed, on both sides of the redirect:
# VIQ_GOOGLE_REDIRECT_URI=https://your-api-host/api/auth/google/callback
# VIQ_FRONTEND_URL=https://your-app.vercel.app

# GST taxpayer verification (optional; public register data only).
# Subscribe to "GST Return Status" on RapidAPI (free tier: 1,000/day) and set:
# VIQ_GST_API_HOST=gst-return-status.p.rapidapi.com
# The vendor's own keyless endpoint works too, and needs no subscription:
# VIQ_GST_API_HOST=gst.jamku.app
# VIQ_GST_API_PATH=/api/gstin/{gstin}

# Defaults to SQLite at backend/ventureiq.db.
# VIQ_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ventureiq

# Browsers that may call this API. Local dev origins are allowed by default;
# add your deployed frontend when you host one.
# VIQ_CORS_ORIGINS=["https://ventureiq.vercel.app"]
