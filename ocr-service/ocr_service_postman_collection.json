        {
            "name": "Parse Bill from URL",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"file_url\": \"https://example.com/path/to/bill.jpg\",\n    \"use_easyocr\": false\n}"
                },
                "url": {
                    "raw": "http://localhost:5000/api/parse-bill",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "5000",
                    "path": [
                        "api",
                        "parse-bill"
                    ]
                },
                "description": "Parse a bill from a publicly accessible URL. Supports images (PNG, JPG, JPEG, TIFF, BMP) and PDF files."
            },
            "response": []
        },
        {
            "name": "Parse Bill from Base64",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n    \"image_base64\": \"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==\",\n    \"use_easyocr\": false\n}"
                },
                "url": {
                    "raw": "http://localhost:5000/api/parse-bill-base64",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "5000",
                    "path": [
                        "api",
                        "parse-bill-base64"
                    ]
                },
                "description": "Parse a bill from a base64 encoded image. Replace the image_base64 value with your actual base64 encoded image data."
            },
            "response": []
        },
